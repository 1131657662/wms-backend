# 服务端口
PORT=3000
HOST=127.0.0.1

# MySQL 数据库连接
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wms
DB_USER=root
DB_PASSWORD=your_db_password_here

# 数据库备份（生产环境建议把目录设置到项目源码目录之外）
# WMS_BACKUP_DIR=/var/backups/wms
# WMS_BACKUP_TIMEOUT_MS=600000
# MYSQLDUMP_BIN=/usr/bin/mysqldump
# MYSQL_BIN=/usr/bin/mysql
# WMS_ALLOW_WEB_RESTORE=false

# JWT 密钥（生产环境请使用随机字符串）
JWT_SECRET=wms_jwt_secret_change_me
JWT_EXPIRES_IN=7d

# CORS：填写浏览器访问前端的完整 Origin，多个用英文逗号分隔（例：https://wms.example.com,http://localhost:8848）
# 开发环境可不设置（允许任意来源）。生产环境（NODE_ENV=production）未设置时进程会拒绝启动。
# CORS_ORIGIN=https://你的前端域名

# 反向代理（Nginx）后需解析真实客户端 IP 时设为 1，以便登录/导出限流按真实 IP 统计
# TRUST_PROXY=1

# 限流（15 分钟窗口）：可按需调大/调小
# LOGIN_RATE_LIMIT_MAX=30
# WX_AUTH_RATE_LIMIT_MAX=60
# REPORT_RATE_LIMIT_MAX=200
# EXPORT_RATE_LIMIT_MAX=60
# PRINT_RATE_LIMIT_MAX=40

# 列表分页：常规接口单页最大条数（默认 1000）；入库/出库单列表/搜索另受 WMS_BULK_LIST_MAX 约束（默认 50000，硬顶 100000）
# API_MAX_PAGE_SIZE=1000
# WMS_BULK_LIST_MAX=50000

# 微信小程序 jscode2session（须与小程序 project.config.json 的 appid 一致；AppSecret 在微信公众平台 → 开发设置）
WX_APPID=wx539425b4fa0aacac
WX_APP_SECRET=your_app_secret_from_mp_admin
